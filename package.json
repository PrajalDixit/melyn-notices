{
  "name": "melyn-notices",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "axios": "^1.21.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsc --noEmit",
    "test:adlc": "npm run test && npm run test:e2e",
    "test:e2e": "maestro test .maestro",
    "test:e2e:android": "maestro --platform=android test .maestro",
    "test:e2e:ios": "maestro --platform=ios test .maestro",
    "test:e2e:start-device": "maestro start-device"
  },
  "private": true
}
