{
  "expo": {
    "name": "Community Notices",
    "slug": "melyn-notices",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/image/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.melyn.notices"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/image/android-icon-foreground.png",
        "backgroundImage": "./src/assets/image/android-icon-background.png",
        "monochromeImage": "./src/assets/image/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.melyn.notices"
    },
    "web": {
      "favicon": "./src/assets/image/favicon.png"
    },
    "plugins": [
      "expo-image"
    ],
    "scheme": "melynnotices"
  }
}
